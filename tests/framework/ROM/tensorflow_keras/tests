[Tests]
  # tensorflow 2.21 + tf-keras 2.21 legacy mode is substantially slower than the prior
  # tensorflow 2.14 + keras 2.14 stack used by RAVEN. Each test now needs ~10 min of CPU
  # for the model.fit calls; max_time bumped to 1800 to keep them running on CI.
  [./tf_cnn1d]
    type  = 'RavenFramework'
    input = 'cnn1d.xml'
    required_libraries = 'tensorflow'
    max_time = 1800
    # Marked heavy (opt-in via --heavy) because tf-keras 2.21 + tensorflow 2.21 deadlocks on
    # AbslInternalPerThreadSemWait when PyArrow's bundled libarrow absl loads alongside
    # TF's libtensorflow_framework absl (version mismatch). Standalone tf-keras fits a model
    # in 0.14s; the hang only manifests when both libs are loaded together. Needs separate
    # packaging investigation (re-pin pyarrow or rebuild TF/PyArrow against a common absl).
    heavy = True
    [./data]
        type = OrderedCSV
        output = 'data/outCon1DClassifier.csv'
    [../]
  [../]
  [./tf_mlpc]
