      <Features>u,level,x1_init,x2_init,tEnd</Features>
      <actuators>u</actuators>
      <stateVariables>x1,x2</stateVariables>
      <initStateVariables>x1_init,x2_init</initStateVariables>
      <pivotParameter>Time</pivotParameter>
      <pooled>True</pooled>
      <historyOffsets>True</historyOffsets>
      <validUntil>tEnd</validUntil>
    </ROM>
  </Models>

