<?xml version="1.0" ?>
<Simulation verbosity="debug" profile="jobs">
  <TestInfo>
    <name>framework/Optimizers/GA.RosenbrockDiskConstrainedInvLinLogisticMax</name>
    <author>MohammadAbdo</author>
    <created>2020-05-16</created>
    <classesTested>GeneticAlgorithm</classesTested>
    <description>
      Genetic algorithm with the logistic fitness on the Rosenbrock function constrained to the disk
      x^2 + y^2 &lt;= 2, maximized (&lt;type&gt;max&lt;/type&gt;). The logistic fitness must rank the highest
      objective best and lower the fitness of points outside the disk, so the best feasible point moves
      toward the largest value on the disk boundary and no infeasible point is reported as the optimum.
    </description>
    <analytic>
      This test uses Rosenbrock function.
    </analytic>
    <revisions>
      <revision author="rollnk" date="2025-09-10">'globalSeed' tag added to node 'RunInfo' to enable backwards compatability following updates made to randomUtils.py.</revision>
    </revisions>
  </TestInfo>

  <RunInfo>
    <WorkingDir>rosenbrockDiskConstrainedLogisticMax</WorkingDir>
    <Sequence>optimize, print, plot_results</Sequence>
    <batchSize>1</batchSize>
    <globalSeed>5489</globalSeed>
  </RunInfo>

  <Steps>
    <MultiRun name="optimize" >
      <Input class="DataObjects" type="PointSet">placeholder</Input>
      <Model class="Models" type="ExternalModel">rosenbrock</Model>
      <Optimizer class="Optimizers" type="GeneticAlgorithm">GAopt</Optimizer>
      <SolutionExport class="DataObjects" type="PointSet">opt_export</SolutionExport>
      <Output class="DataObjects" type="PointSet">optOut</Output>
      <Output class="OutStreams" type="Print">opt_export</Output>
    </MultiRun>
    <IOStep name="print">
      <Input class="DataObjects" type="PointSet">opt_export</Input>
      <Input class="DataObjects" type="PointSet">optOut</Input>
      <Output class="OutStreams" type="Print">opt_export</Output>
      <Output class="OutStreams" type="Print">optOut</Output>
    </IOStep>
    <IOStep name="plot_results">
      <Input class="DataObjects" type="PointSet">opt_export</Input>
      <Output class="OutStreams" type="Plot">opt_path</Output>
      <Output class="OutStreams" type="Plot">population</Output>
      <Output class="OutStreams" type="Plot">parallel_coordinates</Output>
    </IOStep>
  </Steps>

  <Distributions>
    <Uniform name='rosenbrock_dist_x'>
      <lowerBound>-1.5</lowerBound>
      <upperBound>1.5</upperBound>
    </Uniform>
    <Uniform name='rosenbrock_dist_y'>
      <lowerBound>-1.5</lowerBound>
      <upperBound>1.5</upperBound>
    </Uniform>
  </Distributions>

  <Optimizers>
    <GeneticAlgorithm name="GAopt">
      <samplerInit>
        <limit>10</limit>
        <initialSeed>42</initialSeed>
        <writeSteps>every</writeSteps>
        <type>max</type>
      </samplerInit>

      <GAparams>
        <populationSize>30</populationSize>
        <parentSelection>rouletteWheel</parentSelection>
        <reproduction>
          <crossover type="onePointCrossover">
            <crossoverProb>0.8</crossoverProb>
          </crossover>
          <mutation type="swapMutator">
            <mutationProb>0.9</mutationProb>
          </mutation>
        </reproduction>
        <fitness type="logistic">
          <scale>0.05</scale>
          <shift>300.0</shift>
        </fitness>
        <survivorSelection>fitnessBased</survivorSelection>
      </GAparams>

      <convergence>
        <AHDp>0.0</AHDp>
      </convergence>

      <variable name="x">
        <distribution>rosenbrock_dist_x</distribution>
      </variable>
      <variable name="y">
        <distribution>rosenbrock_dist_y</distribution>
      </variable>

      <objective>ans</objective>
      <TargetEvaluation class="DataObjects" type="PointSet">optOut</TargetEvaluation>
    <Sampler class="Samplers" type="MonteCarlo">MC_samp</Sampler>
    <Constraint class='Functions' type='External'>constraint1</Constraint>
    </GeneticAlgorithm>
  </Optimizers>

  <Samplers>
    <MonteCarlo name="MC_samp">
      <samplerInit>
        <limit>30</limit>
        <initialSeed>20021986</initialSeed>
      </samplerInit>
      <variable name="x">
        <distribution>rosenbrock_dist_x</distribution>
      </variable>
      <variable name="y">
        <distribution>rosenbrock_dist_y</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Models>
    <ExternalModel ModuleToLoad="../../../../../AnalyticModels/optimizing/rosenbrockDiskConstrained.py" name="rosenbrock" subType="">
      <variables>x,y,ans</variables>
    </ExternalModel>
  </Models>

  <Functions>
    <External file="../../../../../AnalyticModels/optimizing/rosenbrockDiskConstrained.py" name="constraint1">
      <variables>x,y</variables>
    </External>
  </Functions>

    <DataObjects>
      <PointSet name="placeholder"/>
      <PointSet name="optOut">
        <Input>x,y</Input>
        <Output>ans</Output>
      </PointSet>
      <PointSet name="opt_export">
        <Input>trajID</Input>
        <Output>x,y,ans,age,batchId,fitness,iteration,accepted,AHDp,conv_AHDp,ConstraintEvaluation_constraint1</Output>
      </PointSet>
    </DataObjects>

    <OutStreams>
      <Print name="optOut">
        <type>csv</type>
        <source>optOut</source>
      </Print>
      <Print name="opt_export">
        <type>csv</type>
        <source>opt_export</source>
        <clusterLabel>trajID</clusterLabel>
      </Print>
    
      <Plot name="opt_path" subType="OptPath">
        <source>opt_export</source>
        <vars>x,y,ans</vars>
      </Plot>
      <Plot name="population" subType="PopulationPlot">
        <source>opt_export</source>
        <vars>x,y,ans</vars>
        <index>batchId</index>
        <how>png</how>
      </Plot>
      <Plot name="parallel_coordinates" subType="OptParallelCoordinatePlot">
        <source>opt_export</source>
        <vars>x,y</vars>
        <index>batchId</index>
      </Plot>
    </OutStreams>
</Simulation>
