      <label for="_anim_radio1_7fb6cf1e9a3569c20cdfa8452b4de831">Once</label>
      <input type="radio" name="state" value="loop" id="_anim_radio2_7fb6cf1e9a3569c20cdfa8452b4de831"
             checked>
      <label for="_anim_radio2_7fb6cf1e9a3569c20cdfa8452b4de831">Loop</label>
      <input type="radio" name="state" value="reflect" id="_anim_radio3_7fb6cf1e9a3569c20cdfa8452b4de831"
             >
      <label for="_anim_radio3_7fb6cf1e9a3569c20cdfa8452b4de831">Reflect</label>
    </form>
