<?xml version="1.0" ?>
<Simulation verbosity="debug" profile="jobs">
  <TestInfo>
    <name>raven/tests/framework/Optimizers/GeneticAlgorithms.NSGAII</name>
    <author>Mohammad Abdo</author>
    <created>2025-01-09</created>
    <classesTested/>
    <description>NSGA-II min-max test </description>
  </TestInfo>

  <RunInfo>
    <WorkingDir>MultiwoReplacementFeasibleFirstInitial</WorkingDir>
    <Sequence>optimize,print</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Steps>
    <MultiRun name="optimize" re-seeding="2286">
      <Input class="DataObjects" type="PointSet">placeholder</Input>
      <Model class="Models" type="ExternalModel">myLocalSum</Model>
      <Optimizer class="Optimizers" type="NSGA-II">GAopt</Optimizer>
      <SolutionExport class="DataObjects" type="PointSet">opt_export</SolutionExport>
      <Output class="DataObjects" type="PointSet">optOut</Output>
      <Output class="OutStreams" type="Print">opt_export</Output>
    </MultiRun>
    <IOStep name="print">
      <Input class="DataObjects" type="PointSet">opt_export</Input>
      <Input class="DataObjects" type="PointSet">optOut</Input>
      <Output class="OutStreams" type="Print">opt_export</Output>
      <Output class="OutStreams" type="Print">optOut</Output>
      <Output class="OutStreams" type="Plot">opt_path</Output>
      <Output class="OutStreams" type="Plot">population</Output>
      <Output class="OutStreams" type="Plot">pareto_front</Output>
      <Output class="OutStreams" type="Plot">front_evolution</Output>
      <Output class="OutStreams" type="Plot">front_evolution_gif</Output>
      <Output class="OutStreams" type="Plot">rank_history</Output>
      <Output class="OutStreams" type="Plot">crowding_distance</Output>
      <Output class="OutStreams" type="Plot">front_rank_animation</Output>
      <Output class="OutStreams" type="Plot">front_rank_animation_gif</Output>
    </IOStep>
  </Steps>

  <Models>
    <ExternalModel ModuleToLoad="../../../../AnalyticModels/optimizing/myLocalSum_multi.py" name="myLocalSum" subType="">
      <variables>x1,x2,x3,obj1,obj2</variables>
    </ExternalModel>
  </Models>

  <Functions>
    <External file="../../../../AnalyticModels/optimizing/myConstraints.py" name="expConstr1">
      <variables>x1,x2,x3</variables>
    </External>
    <External file="../../../../AnalyticModels/optimizing/myConstraints.py" name="impConstr2">
      <variables>x1,x2,x3,obj1</variables>
    </External>
    <External file="../../../../AnalyticModels/optimizing/myConstraints.py" name="impConstr3">
      <variables>x1,x2,x3,obj1</variables>
    </External>
  </Functions>

  <Files>
      <Input name="my_smaples" type="">../samples.csv</Input>
  </Files>

  <Distributions>
    <UniformDiscrete name='woRep_dist'>
      <lowerBound>2</lowerBound>
      <upperBound>7</upperBound>
      <strategy>withoutReplacement</strategy>
    </UniformDiscrete>
  </Distributions>

  <Optimizers>
    <NSGA-II name="GAopt">
      <samplerInit>
        <limit>5</limit>
        <initialSeed>42</initialSeed>
        <writeSteps>every</writeSteps>
        <type>min, max</type>
      </samplerInit>
      <GAparams>
        <populationSize>120</populationSize>
        <parentSelection>tournamentSelection</parentSelection>
        <reproduction>
          <crossover type="twoPointsCrossover">
            <crossoverProb>0.8</crossoverProb>
          </crossover>
          <mutation type="swapMutator">
            <mutationProb>0.8</mutationProb>
          </mutation>
        </reproduction>
        <fitness type="feasibleFirst">
        </fitness>
        <survivorSelection>rankNcrowdingBased</survivorSelection>
      </GAparams>
      <convergence>
        <AHDp>0.0</AHDp>
      </convergence>
      <variable name="x1">
        <distribution>woRep_dist</distribution>
      </variable>
      <variable name="x2">
        <distribution>woRep_dist</distribution>
      </variable>
      <variable name="x3">
        <distribution>woRep_dist</distribution>
      </variable>
      <objective>obj1, obj2</objective>
      <TargetEvaluation class="DataObjects" type="PointSet">optOut</TargetEvaluation>
      <Sampler class="Samplers" type="CustomSampler">my_sampler</Sampler>
    </NSGA-II>
  </Optimizers>

  <Samplers>
    <CustomSampler name="my_sampler">
      <Source class="Files" type="">my_smaples</Source>
      <variable name="x1"/>
      <variable name="x2"/>
      <variable name="x3"/>
    </CustomSampler>
  </Samplers>


  <DataObjects>
    <PointSet name="placeholder"/>
    <PointSet name="optOut">
      <Input>x1,x2,x3</Input>
      <Output>obj1, obj2</Output>
    </PointSet>
    <PointSet name="opt_export">
      <Input>trajID</Input>
      <Output>x1,x2,x3,obj1,obj2,batchId,rank,CD,FitnessEvaluation_obj1,FitnessEvaluation_obj2,accepted </Output><!--,age-->
    </PointSet>
  </DataObjects>

  <OutStreams>
    <Print name="optOut">
      <type>csv</type>
      <source>optOut</source>
    </Print>
    <Print name="opt_export">
      <type>csv</type>
      <source>opt_export</source>
      <clusterLabel>trajID</clusterLabel>
    </Print>
    <Plot name = "opt_path" subType="OptPath">
      <source>opt_export</source>
      <vars>x1, x2, x3, obj1, obj2</vars>
    </Plot>
    <Plot name="population" subType="PopulationPlot">
      <source> opt_export</source>
      <vars>x1, x2, x3, obj1, obj2</vars>
      <index>batchId</index>
      <how>png</how>
    </Plot>
    <Plot name="pareto_front" subType="NSGAParetoFrontPlot">
      <source>opt_export</source>
      <objectives>obj1, obj2, obj3</objectives>
      <color>CD</color>
      <rank>1</rank>
    </Plot>
    <Plot name="front_evolution" subType="NSGAFrontAnimation">
      <source>opt_export</source>
      <objectives>obj1, obj2</objectives>
      <index>batchId</index>
      <rank>1</rank>
      <fps>2.0</fps>
      <format>html</format>
    </Plot>
    <Plot name="front_evolution_gif" subType="NSGAFrontAnimation">
      <source>opt_export</source>
      <objectives>obj1, obj2</objectives>
      <index>batchId</index>
      <rank>1</rank>
      <fps>2.0</fps>
      <format>gif</format>
    </Plot>
    <Plot name="rank_history" subType="NSGARankHistoryPlot">
      <source>opt_export</source>
      <index>batchId</index>
      <normalize>true</normalize>
    </Plot>
    <Plot name="crowding_distance" subType="NSGACrowdingDistancePlot">
      <source>opt_export</source>
      <index>batchId</index>
      <percentiles>10, 50, 90</percentiles>
    </Plot>
    <Plot name="front_rank_animation" subType="NSGAFrontRankAnimation">
      <source>opt_export</source>
      <objectives>obj1, obj2</objectives>
      <index>batchId</index>
      <fps>2.0</fps>
      <format>html</format>
    </Plot>
    <Plot name="front_rank_animation_gif" subType="NSGAFrontRankAnimation">
      <source>opt_export</source>
      <objectives>obj1, obj2</objectives>
      <index>batchId</index>
      <fps>2.0</fps>
      <format>gif</format>
    </Plot>
  </OutStreams>
</Simulation>
