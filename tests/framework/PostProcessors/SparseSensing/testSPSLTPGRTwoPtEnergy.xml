<?xml version="1.0" ?>
<Simulation verbosity="debug">
  <TestInfo>
    <name>tests/framework/Postprocessors/SparseSensing/TPGRTwoPtEnergy</name>
    <author>Jimmy-INL</author>
    <created>2026-04-19</created>
    <classesTested>Models.Postprocessors.SparseSensing</classesTested>
    <description>This test checks that the SparseSensing PostProcessor exposes
     the pysensors TPGR two-point energy landscape on the candidateSensor index.
    </description>
  </TestInfo>

  <RunInfo>
    <WorkingDir>tpgrTwoPtEnergy</WorkingDir>
    <Sequence>LoadCSV, mySPpp, print</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Files>
    <Input name="fieldList" type="">../gqrCircle/Perturbations.csv</Input>
    <Input name="refDO"     type="">../gqrCircle/sample0.csv</Input>
  </Files>

  <Steps>
    <IOStep name="LoadCSV">
      <Input  class="Files"       type="">fieldList</Input>
      <Input  class="Files"       type="">refDO</Input>
      <Output class="DataObjects" type="HistorySet">FieldDO</Output>
      <Output class="DataObjects" type="PointSet">RefDO</Output>
    </IOStep>
    <PostProcess name="mySPpp">
      <Input  class="DataObjects" type="HistorySet">FieldDO</Input>
      <Model  class="Models"      type="PostProcessor">mySPSL</Model>
      <Output class="DataObjects" type="DataSet">outPP</Output>
    </PostProcess>
    <IOStep name="print">
      <Input  class="DataObjects" type="DataSet">outPP</Input>
      <Output class="OutStreams"  type="Print">outPP</Output>
    </IOStep>
  </Steps>

  <Models>
    <PostProcessor name="mySPSL" subType="SparseSensing" verbosity="debug">
      <Goal subType="reconstruction">
        <features>X (m),Y (m),Temperature (K)</features>
        <target>Temperature (K)</target>
        <basis>SVD</basis>
        <nModes>2</nModes>
        <nSensors>2</nSensors>
        <optimizer>TPGR</optimizer>
        <energyLandscapeMetrics>two_pt</energyLandscapeMetrics>
        <energyLandscapeSensors>4</energyLandscapeSensors>
        <uncertaintyNoise>0.2</uncertaintyNoise>
        <seed>0</seed>
      </Goal>
    </PostProcessor>
  </Models>

  <DataObjects>
    <PointSet name="RefDO">
      <Output>X (m),Temperature (K),Y (m)</Output>
    </PointSet>
    <HistorySet name="FieldDO">
      <Input>sampleID</Input>
      <Output>X (m),Temperature (K),Y (m)</Output>
      <options>
        <pivotParameter>index</pivotParameter>
      </options>
    </HistorySet>
    <DataSet name="outPP">
      <Input>InputPlaceHolder</Input>
      <Output>candidate_X (m), candidate_Y (m), candidate_Temperature (K), twoPtEnergyLandscape</Output>
      <Index var="candidateSensor">candidate_X (m), candidate_Y (m), candidate_Temperature (K), twoPtEnergyLandscape</Index>
    </DataSet>
  </DataObjects>

  <OutStreams>
    <Print name="outPP">
      <type>csv</type>
      <source>outPP</source>
      <what>output</what>
    </Print>
  </OutStreams>

</Simulation>
